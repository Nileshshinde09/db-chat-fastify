APP_NAME=DB Chat Agentic RAG
APP_ENV=development
DEBUG=false
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=db_chat
CHECKPOINT_DATABASE=db_chat_checkpoints

OLLAMA_BASE_URL=http://localhost:11434
ROUTER_MODEL=qwen3:1.7b
SQL_MODEL=qwen2.5-coder:3b
NOSQL_MODEL=qwen2.5-coder:3b
EMBEDDING_MODEL=nomic-embed-text

VECTOR_STORE_PATH=./storage/chroma
RETRIEVER_TOP_K=4
MAX_QUERY_ROWS=500
QUERY_TIMEOUT_SECONDS=15
MAX_QUERY_REPAIR_ATTEMPTS=2

# Configure only trusted, read-only database connections here.
# Do not accept raw database URLs from chat messages.
SQLITE_PATH=./storage/demo.db
POSTGRES_URI=
MYSQL_URI=
MONGODB_CHAT_URI=
MONGODB_CHAT_DATABASE=
